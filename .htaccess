# grupoervoy.com
# Kanonizacja adresu, pamiec podreczna, naglowki bezpieczenstwa, strona bledu.
# Toggle "Force HTTPS Redirect" w cPanelu jest dostepny tylko dla domeny glownej
# konta, a grupoervoy.com jest domena dodatkowa - stad kanonizacja tutaj.

# ---------------------------------------------------------------- kanonizacja
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://grupoervoy.com/$1 [R=301,L]

  # www -> bez www
  RewriteCond %{HTTP_HOST} ^www\.grupoervoy\.com$ [NC]
  RewriteRule ^(.*)$ https://grupoervoy.com/$1 [R=301,L]

  # stara wersja polska siedziala pod /pl/ - od v2 polski jest domyslny pod /
  RewriteRule ^pl(/.*)?$ https://grupoervoy.com/ [R=301,L]

  # Strona glowna: kto wchodzi wprost na grupoervoy.com, trafia na wersje wg jezyka przegladarki.
  # Polski zostaje pod /, hiszpanski z Meksyku (es-MX, es-419 albo samo es) -> /es/, kazdy inny -> /en/.
  # Pomijamy roboty (Google i Bing musza widziec wszystkie wersje, zwykle nie wysylaja Accept-Language),
  # przejscia z wnetrza strony i tych, ktorzy wybrali jezyk flaga (ciasteczko ervoy_lang z site.js).
  # 302, nie 301 - przekierowanie zalezy od odwiedzajacego.
  RewriteCond %{HTTP:Accept-Language} !^$
  RewriteCond %{HTTP:Accept-Language} !^pl [NC]
  RewriteCond %{HTTP_COOKIE} !ervoy_lang=
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?grupoervoy\.com/ [NC]
  RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|google|bing|chatgpt|openai|claude|anthropic|perplexity|facebookexternalhit|whatsapp|linkedin|preview|lighthouse|headless) [NC]
  RewriteCond %{HTTP:Accept-Language} ^es(-mx|-419)?(,|;|$) [NC]
  RewriteRule ^$ https://grupoervoy.com/es/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} !^$
  RewriteCond %{HTTP:Accept-Language} !^pl [NC]
  RewriteCond %{HTTP_COOKIE} !ervoy_lang=
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?grupoervoy\.com/ [NC]
  RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|google|bing|chatgpt|openai|claude|anthropic|perplexity|facebookexternalhit|whatsapp|linkedin|preview|lighthouse|headless) [NC]
  RewriteRule ^$ https://grupoervoy.com/en/ [R=302,L]
</IfModule>

# --------------------------------------------------------------- strona bledu
ErrorDocument 404 /404.html

# HTML, llms.txt i robots.txt sa w UTF-8 - bez tego serwer wysyla text/html bez charset
AddDefaultCharset UTF-8

# ---------------------------------------------------------------- roboty AI
# Hosting nethero oddaje 403 crawlerom AI (GPTBot, ClaudeBot, PerplexityBot,
# CCBot) - blokada nie pochodzi z tego pliku, tylko z konfiguracji wyzej.
# robots.txt przepuszcza wszystkich, wiec probujemy odzyskac kontrole nad
# autoryzacja dla tego katalogu. Jesli po wdrozeniu te crawlery nadal dostaja
# 403, blokada siedzi w vhoscie i zdejmie ja tylko wsparcie nethero.
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# ------------------------------------------------------------ pamiec podreczna
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HTML i pliki dla robotow: zawsze swieze, bo tresc zmienia sie bez zmiany nazwy
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # obrazy i ikony
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # arkusz, skrypt i podklad mapy maja odcisk tresci w nazwie (style.<hash>.css, site.<hash>.js, map.<hash>.svg),
  # wiec kazda zmiana = nowy adres i mozna je trzymac rok
  <FilesMatch "^((style|site)\.[0-9a-f]{8}\.(css|js)|map\.[0-9a-f]{8}\.svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------ naglowki bezpieczenstwa
<IfModule mod_headers.c>
  # odpowiedz pod / zalezy od jezyka przegladarki i ciasteczka - informujemy o tym cache posrednie
  <If "%{REQUEST_URI} == '/'">
    Header always append Vary "Accept-Language, Cookie"
  </If>

  # HSTS tylko po HTTPS; bez includeSubDomains, zeby nie zwiazac sobie rak
  # przy ewentualnej poddomenie
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"

  # X-XSS-Protection jest przestarzaly i w starych przegladarkach sam bywa
  # wektorem ataku; hosting ustawia "1; mode=block", wiec go zerujemy
  Header always set X-XSS-Protection "0"

  # Strona v2 to statyczny HTML: jedyny skrypt to /assets/site.<hash>.js, a bloki
  # application/ld+json nie sa wykonywane, wiec skrypty tylko z 'self'. Style
  # wpisane w strone (animacja hero, atrybuty style=) wymagaja 'unsafe-inline'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
